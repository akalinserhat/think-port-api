{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@akalin/ai-assistants": ["./node_modules/@akalin/ai-assistants/src/index.ts"],
      "@akalin/ai_assistants": ["./node_modules/@akalin/ai-assistants/src/index.ts"],
      "@akalin/ui": ["./node_modules/@akalin/ui/src/index.ts"],
      "@akalin/module_core": ["./node_modules/@akalin/module_core/src/index.ts"],
      "@akalin/module-core": ["./node_modules/@akalin/module_core/src/index.ts"],
      "@akalin/email_module": ["./node_modules/@akalin/email_module/src/index.ts"],
      "@akalin/email-module": ["./node_modules/@akalin/email_module/src/index.ts"],
      "@akalin/global_search_module": ["./node_modules/@akalin/global_search_module/src/index.ts"],
      "@akalin/global-search-module": ["./node_modules/@akalin/global_search_module/src/index.ts"],
      "@akalin/user_auth_module": ["../../akalin-user-auth-module/src/index.ts"],
      "@akalin/user-auth-module": ["../../akalin-user-auth-module/src/index.ts"],
      "@akalin/proxy_module": ["../../akalin-proxy-module/src/index.ts"],
      "@akalin/proxy-module": ["../../akalin-proxy-module/src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react-router-dom": ["./node_modules/react-router-dom"],
      "react-i18next": ["./node_modules/react-i18next"],
      "i18next": ["./node_modules/i18next"],
      "react-hot-toast": ["./node_modules/react-hot-toast"],
      "lucide-react": ["./node_modules/lucide-react"],
      "axios": ["./node_modules/axios"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
